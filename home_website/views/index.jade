extends layout

block content
  .hero
    .hero-content
      .team-badge The Admins
      h1 Proiect RC
      p.hero-subtitle University project showcase — 4 assignments, 1 team
      .hero-status
        .stat
          span.stat-number 4
          span.stat-label Assignments
        .stat
          span.stat-number 1
          span.stat-label Completed
        .stat
          span.stat-number 3
          span.stat-label In Progress

  .container
    .section-title
      h2 Our Assignments
      p Click on a card to explore each project

    .cards
      a.card(href='#', onclick='return false;')
        .card-icon
          svg(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
            circle(cx='12', cy='12', r='10')
            line(x1='2', y1='12', x2='22', y2='12')
            path(d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z')
        .card-body
          .card-header
            h3 DNS AdBlocker
            span.badge.badge-progress In Progress
          p A DNS-based solution to block advertisements and tracking domains at the network level.
        .card-footer
          span.card-link Coming Soon

      a.card(href='#', onclick='return false;')
        .card-icon
          svg(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
            rect(x='3', y='3', width='18', height='18', rx='2', ry='2')
            line(x1='3', y1='9', x2='21', y2='9')
            line(x1='9', y1='21', x2='9', y2='9')
        .card-body
          .card-header
            h3 MXMap
            span.badge.badge-progress In Progress
          p Mapping mail exchanger servers to visualize and analyze email infrastructure.
        .card-footer
          span.card-link Coming Soon

      a.card(href='https://andrei12225.engineer/', target='_blank', rel='noopener noreferrer')
        .card-icon
          svg(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
            path(d='M13 2L3 14h9l-1 8 10-12h-9l1-8z')
        .card-body
          .card-header
            h3 TCP Hijacking
            span.badge.badge-done Done
          p Exploring TCP session hijacking techniques and demonstrating proof-of-concept attacks.
        .card-footer
          span.card-link Visit Project &rarr;

      a.card(href='#', onclick='return false;')
        .card-icon
          svg(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
            path(d='M22 12h-4l-3 9L9 3l-3 9H2')
        .card-body
          .card-header
            h3 DNS Tunnel
            span.badge.badge-progress In Progress
          p Tunneling data through DNS queries and responses for covert communication channels.
        .card-footer
          span.card-link Coming Soon

    .made-with
      p Built with &hearts; by The Admins